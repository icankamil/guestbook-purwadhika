{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2020",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true
  },
  "ts-node": {
    "esm": false,
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "module": "es2020"
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}